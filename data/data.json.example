      "chapter_title": "NHỮNG QUY ĐỊNH CHUNG",
      "section_number": null,
      "section_title": null,
      "article_number": 1,
      "article_title": "Phạm vi điều chỉnh",
      "clause_number": null,
      "clause_title": null,
      "point": null,
